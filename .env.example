# CRM Imobiliário Ultra — variáveis de ambiente.
# Copie para `.env.local` (dev) ou configure no painel do host (produção).
# NUNCA comite `.env.local`: ele tem segredos.

# ─────────────────────────────────────────────────────────────────────────────
# OBRIGATÓRIAS (o app não sobe sem elas — validação fail-closed no boot)
# ─────────────────────────────────────────────────────────────────────────────

# Assina o token de acesso ao demo e a sessão do admin (HMAC-SHA256).
# 16+ caracteres aleatórios. Gere com: openssl rand -base64 32
# Trocar este valor invalida TODOS os acessos e sessões abertas.
APP_SECRET=

# Senha do painel de leads (/admin). 8+ caracteres — use uma forte de verdade:
# é a única coisa entre a internet e a sua base de contatos.
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUÇÃO (obrigatórias quando NODE_ENV=production)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres dos leads (Neon/Supabase). Sem ela em produção o boot PARA — de
# propósito: gravar em disco na Vercel perderia todo lead na primeira
# reciclagem da lambda, em silêncio.
# Rode `migrations/001-leads.sql` uma vez no banco novo.
# Em dev, deixe vazio: o app usa data/leads.json.
DATABASE_URL=

# Envio do código de verificação (https://resend.com).
# Em produção é OBRIGATÓRIA: sem ela o app não sobe, porque o fallback de
# desenvolvimento devolveria o código na resposta da API — qualquer um entraria
# no demo com o e-mail de qualquer pessoa.
# Em dev, deixe vazio: o código aparece na própria tela.
RESEND_API_KEY=

# Remetente. Precisa ser de um domínio VERIFICADO no Resend (SPF/DKIM no DNS),
# senão o Resend só entrega no e-mail dono da conta. O domínio do endereço tem de
# ser EXATAMENTE o verificado (ex.: o subdomínio mail.crmultra.com.br).
# Dois formatos aceitos:
#   acesso@mail.crmultra.com.br              → sai como "CRM Ultra <acesso@…>"
#   CRM Ultra <acesso@mail.crmultra.com.br>  → sai com o nome que você escreveu
# Sem nome, o envio usa o nome curto da marca (brand.nomeCurto). As respostas do
# corretor vão para o e-mail de contato da marca (brand.contato.email), não para cá.
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# OPCIONAIS
# ─────────────────────────────────────────────────────────────────────────────

# Conexões simultâneas por instância no Postgres (padrão 3). Em serverless,
# mantenha baixo: cada lambda abre o seu próprio pool.
# DATABASE_POOL_MAX=3
