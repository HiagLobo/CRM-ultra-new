# O pacote @vercel/analytics declara Svelte, Vue e Remix como pares opcionais.
# O npm 11 tenta resolver essas trilhas mesmo sem usarmos nenhuma delas e esbarra
# num Vite 8 que briga com o Vitest do projeto. Esta linha manda o npm ignorar
# pares que nao instalamos. Vale aqui e na Vercel (ela le este arquivo).
legacy-peer-deps=true
